# ============================================================
# PQBS — Environment Variable Reference
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# ------------------------------------------------------------
# CockroachDB
# ------------------------------------------------------------
# Full psycopg connection string to the CockroachDB cluster.
# Format: cockroachdb://user:password@host:port/database?sslmode=verify-full
COCKROACH_URL=postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full&sslrootcert=system

# ------------------------------------------------------------
# AWS
# ------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model for text generation (A1, A3, A16 use this)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Bedrock model for embeddings (A12 uses this)
# Produces 1024-dimensional vectors — matches EMBEDDING_DIM in contracts
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ------------------------------------------------------------
# Infrastructure
# ------------------------------------------------------------
# WORM audit sink — TWO BUCKETS REQUIRED
# Production bucket: S3 Object Lock COMPLIANCE mode, 365-day retention (cannot delete)
WORM_BUCKET=
# Dev bucket: no retention lock — use this for all development and test audit records
WORM_BUCKET_DEV=

# CockroachDB CDC changefeed sink URL (SQS ARN or Kafka topic URL)
CHANGEFEED_SINK_URL=

# Version string stamped on every ChangeEvent and Verdict
SCREENER_VERSION=1.0.0

# ------------------------------------------------------------
# Tenant UUIDs
# ------------------------------------------------------------
TENANT_ID_DEMO=
# Evaluation tenant — separate from demo; A15 red-team corpus writes here
TENANT_ID_EVAL=

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Must match EMBEDDING_DIM in src/pqbs/contracts/base.py
EMBEDDING_DIM=1024

LOG_LEVEL=INFO

# development | staging | production
ENVIRONMENT=development

# Screening gate thresholds (verdict composition)
TRUST_THRESHOLD=0.7
QUARANTINE_THRESHOLD=0.4

# Write-path retry cap (serializable conflicts)
MAX_RETRY_ATTEMPTS=5

# CDC polling fallback interval in seconds (only used if V2 spike shows CDC unavailable)
POLL_INTERVAL_SECONDS=5
