COCKROACH_URL=postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full&sslrootcert=system
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=

# WORM audit sink — TWO BUCKETS REQUIRED
# Production bucket: S3 Object Lock COMPLIANCE mode, 365-day retention (cannot delete)
WORM_BUCKET=
# Dev bucket: no retention lock — use this for all development and test audit records
WORM_BUCKET_DEV=

CHANGEFEED_SINK_URL=
SCREENER_VERSION=

# Tenant UUIDs
TENANT_ID_DEMO=
# Evaluation tenant — separate from demo; A15 red-team corpus writes here
TENANT_ID_EVAL=

# Screening gate thresholds (verdict composition)
TRUST_THRESHOLD=0.7
QUARANTINE_THRESHOLD=0.4

# Write-path retry cap (serializable conflicts)
MAX_RETRY_ATTEMPTS=5

# CDC polling fallback interval in seconds (only used if V2 spike shows CDC unavailable)
POLL_INTERVAL_SECONDS=5
